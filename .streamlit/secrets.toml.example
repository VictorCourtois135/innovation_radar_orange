# Copy this file to .streamlit/secrets.toml and fill in the real values.
#
# .streamlit/secrets.toml is already in .gitignore. Never commit it.
#
# You do not have to use this file at all. radar/data.py reads st.secrets first
# and then falls back to environment variables, so a .env in the project root
# works exactly as well for local development. Use this file when deploying to
# Streamlit Community Cloud, where you paste these values into the app's
# Settings → Secrets panel instead of committing them.
#
# If neither is present the dashboard loads the CSV snapshot in data/ and says
# so in the sidebar. It will not crash.

[azure_sql]
SQL_SERVER = "your-server.database.windows.net"
SQL_DATABASE = "your-database"
SQL_USER = "your-user"
SQL_PASSWORD = "your-password"
